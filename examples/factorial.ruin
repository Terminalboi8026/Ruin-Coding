// Example: Factorial Calculator
// Demonstrates recursive functions in Ruin

func factorial(n) {
    if (n <= 1) {
        return 1;
    }
    return n * factorial(n - 1);
}

// Calculate and display factorials
for (let i = 1; i <= 10; i = i + 1) {
    let result = factorial(i);
    print("Factorial of " + i + " is: " + result);
}
